{
  "realm": "lab",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "clientScopes": [
    {
      "name": "basic",
      "description": "Adds the sub claim to tokens",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "documents.read",
      "description": "Read access to documents",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "documents-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "documents-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "documents-client",
      "name": "Documents client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${DOCUMENTS_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["basic"],
      "optionalClientScopes": ["documents.read"]
    }
  ],
  "users": [
    {
      "id": "7c1d2a10-3b5e-4f6a-9d11-0a1b2c3d4e01",
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Lab",
      "email": "alice@example.com",
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "${ALICE_PASSWORD}", "temporary": false }
      ]
    },
    {
      "id": "7c1d2a10-3b5e-4f6a-9d11-0a1b2c3d4e02",
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Lab",
      "email": "bob@example.com",
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "${BOB_PASSWORD}", "temporary": false }
      ]
    }
  ]
}